# Local SQLite file (created automatically). On Vercel this is ignored —
# the app uses sql.js and persists under /tmp (ephemeral across cold starts).
DATABASE_PATH=data/youform.db

# Force sql.js even locally (useful to smoke-test the Vercel path)
# USE_SQLJS=1

# Force better-sqlite3 even if VERCEL is set (not recommended on serverless)
# USE_BETTER_SQLITE3=1

# Optional: default timeout for outbound form webhooks (ms)
WEBHOOK_TIMEOUT_MS=8000

# Public site origin used when copying share links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI schema-from-brief (optional) ---
# Prefer xAI Grok. If unset, the editor uses honest local heuristic drafts.
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_MODEL=grok-2-latest
# Or OpenAI-compatible:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Build Games shared LLM key (server-side only — never expose to client)
# Prefer xAI (https://api.x.ai/v1); OpenAI-compatible fallback.
# BUILD_GAMES_LLM_API_KEY=
